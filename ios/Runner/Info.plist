<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NornApp</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>NornApp</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ── Cumplimiento de exportación (cifrado) ──
	     La app solo usa el cifrado que ya trae iOS o que va dentro de
	     HTTPS/TLS (Firebase) y el Keychain. Eso está EXENTO, así que se
	     declara NO. Con esta clave App Store Connect deja de preguntar
	     por el cifrado en cada build que subes. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ── AdMob ──
	     App ID de iOS de la cuenta pub-1041809144169910 (AdMob → Apps →
	     NornApp iOS). No confundir con el de Android (~6420046996).
	     Si el valor falta o está mal escrito, la app se cierra al abrir. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-1041809144169910~1303451687</string>

	<!-- ── App Tracking Transparency (anuncios personalizados) ──
	     Texto del aviso del sistema. Debe explicar para qué se usa, sin
	     presionar ni ofrecer nada a cambio (Apple lo rechaza). -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Si lo permites, los anuncios que ves en NornApp serán más relevantes para ti. Si no, seguirás viendo anuncios, pero menos personalizados.</string>

	<!-- ── SKAdNetwork ──
	     Google + compradores externos. Google publica la lista completa y
	     actualizada en: developers.google.com/admob/ios/3p-skadnetworks
	     Copia allí el bloque entero para no perder ingresos. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<!-- ── Galería de fotos ──
	     Apple (5.1.1) rechaza textos que no describen TODOS los usos reales:
	     la galería se usa para la foto de perfil y las imágenes de entrenos. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>NornApp usa tus fotos solo cuando eliges una imagen para tu perfil o para un entrenamiento. Por ejemplo, puedes poner una foto tuya como imagen de perfil.</string>

	<!-- ── Cámara ──
	     CORREGIDO: antes decía que la cámara solo se usaba para el QR, pero
	     image_helpers.dart también permite "Hacer una foto". -->
	<key>NSCameraUsageDescription</key>
	<string>NornApp usa la cámara para escanear el código QR de otra persona y añadirla como contacto, y para hacer una foto de perfil o de un entrenamiento si tú lo eliges. Las imágenes del QR no se guardan.</string>

	<!-- ── Notificaciones push ──
	     Solo 'remote-notification'. Se ha quitado 'fetch' porque la app no
	     usa Background Fetch y Apple puede rechazar modos que no se usan. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Requerido por Flutter para gestos de trackpad/ratón en iPad -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
