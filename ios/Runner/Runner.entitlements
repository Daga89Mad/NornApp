<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notificaciones push (firebase_messaging). Sin esta clave iOS nunca
	     entrega un token APNs y FCM no puede notificar en iPhone.
	     Se deja en "development": al exportar para App Store / TestFlight
	     Xcode la cambia automáticamente a "production". -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
